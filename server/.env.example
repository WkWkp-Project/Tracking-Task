# Server
SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-value
CHAT_ENCRYPTION_KEY=replace-with-a-long-random-value
REMINDER_TIME_ZONE=Asia/Bangkok
CHAT_ATTACHMENT_MAX_BYTES=5242880
ADMIN_EMAIL=admin@wkwkp.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: limit sign-in to one Google Workspace domain. Empty = any Google account.
ALLOWED_GOOGLE_DOMAIN=

# ── Data storage ──────────────────────────────────────────────
# Default: a JSON file (server/data/db.json, or DATA_DIR/db.json).
# Hosts with an ephemeral disk (Render free tier) lose that file on every
# deploy/restart, so point DATABASE_URL at a Postgres database instead
# (Neon / Supabase free tiers work). Everything is stored in one table
# (app_state) that is created automatically. Single server instance only.
DATABASE_URL=
# Managed Postgres needs TLS (the default). Set to false only for a local DB.
# DATABASE_SSL=false
# DATA_DIR=/var/data

# Comma-separated emails that are always super admin (default: jarupat@team.wkwkp.com)
# SUPER_ADMIN_EMAILS=
