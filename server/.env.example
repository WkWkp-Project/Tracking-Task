# ───────────────────────────────────────────────────────────────
# PM Hub – Server configuration
# Copy this file to ".env" and fill in the values.
# The app RUNS even if the Google values are left blank — Google
# features (login with Gmail / send email / calendar) will simply
# report "not configured" until you add the credentials.
# ───────────────────────────────────────────────────────────────

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWT login tokens. Change this to any long random string.
JWT_SECRET=change-this-to-a-long-random-secret-string

# Default password for the seeded admin account (admin@wkwkp.com)
ADMIN_EMAIL=admin@wkwkp.com
ADMIN_PASSWORD=admin1234

# ── Google OAuth2 (you create these in Google Cloud Console) ──
# APIs to enable:  Gmail API, Google Calendar API, People API
# Authorized redirect URI must be EXACTLY:
#   http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Restrict Google login to your workspace domain (leave blank to allow any)
ALLOWED_GOOGLE_DOMAIN=wkwkp.com
